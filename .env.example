# Copy this file to .env and fill in your own values.

# Which model runs the agent: "gemini" (cloud) or "ollama" (local).
ENGINE=gemini

# Gemini API key, free tier available: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: models to try in order (falls back to the next one if a model is busy or missing).
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite

# Only for ENGINE=ollama: a local model that supports tool calling.
# OLLAMA_MODEL=qwen2.5:14b

# Optional settings
# KEEP_TURNS=10        # how many recent user messages are sent to the model
# PORT=5001
# OPEN_BROWSER=1       # 0 = don't open a browser tab on start
# JARVIS_DB=jarvis.db  # SQLite file for chats, tasks and preferences
